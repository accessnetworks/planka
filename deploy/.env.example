# Copy to deploy/.env and fill in:
#   cp .env.example .env && chmod 600 .env
# deploy/.env is git-ignored: never commit it, but DO keep a copy somewhere
# safe. The backups don't include it.

# Hostname users open. DNS must point it at this server's IP.
PLANKA_DOMAIN=planka.accessnet.works

# --- HTTPS: Let's Encrypt through a Cloudflare DNS-01 challenge ---
# Contact address for the Let's Encrypt account (expiry notices).
ACME_EMAIL=
# Cloudflare API token that can edit DNS in the accessnet.works zone:
# Cloudflare dashboard > My Profile > API Tokens > Create Token >
# "Edit zone DNS" template > Zone Resources: Include / Specific zone /
# accessnet.works. Optionally restrict it to this server's public egress IP
# under "Client IP Address Filtering".
CLOUDFLARE_API_TOKEN=

# --- Secrets: generate each with `openssl rand -hex 32` ---
# SECRET_KEY signs every login token. POSTGRES_PASSWORD is used inside a URL,
# so keep it hex (no @ : / characters).
SECRET_KEY=
POSTGRES_PASSWORD=

# --- SSO (Authentik) ---
# Set all three together. An issuer without a client ID breaks the login page
# for everyone, local accounts included. Leave OIDC_ISSUER empty to run with
# local accounts only. In the Authentik provider, the redirect URI must be
# exactly https://<PLANKA_DOMAIN>/oidc-callback
# e.g. OIDC_ISSUER=https://auth.1plan.net/application/o/1-plan-provisioning/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile

# --- Backups ---
# Seconds between backups (86400 = daily) and how many of each to keep.
BACKUP_INTERVAL=86400
BACKUP_KEEP=14

# --- Optional ---
# DEFAULT_LANGUAGE=en-US
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM='"1Plan Provisioning" <planka@accessnet.works>'
