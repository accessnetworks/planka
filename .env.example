# Copy this file to `.env` (same directory) and fill in the values.
# docker-compose-dev.yml reads these automatically for OIDC / SSO.
# `.env` is git-ignored — never commit real client secrets.
#
# These configure PLANKA's built-in OIDC login against Authentik (the same
# identity provider RavAN uses at https://auth.1plan.net). New SSO users are
# auto-created in the local database as "boardUser" (OIDC_IGNORE_ROLES=true is
# pinned in the compose file, so groups can't escalate them to admin/owner).

# ── Authentik provider (create a NEW application + OAuth2/OIDC provider for
#    PLANKA in Authentik — do NOT reuse RavAN's client) ───────────────────────
# The OpenID issuer URL. In Authentik this is the provider's "OpenID
# Configuration Issuer" (Providers → your PLANKA provider). Example shape:
#   https://auth.1plan.net/application/o/<planka-app-slug>/
OIDC_ISSUER=

# Client ID / secret from the Authentik provider for PLANKA.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional — defaults to "openid email profile" if omitted.
# OIDC_SCOPES=openid email profile
